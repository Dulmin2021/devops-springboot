# ─────────────────────────────────────────────
# .gitignore for Spring Boot / Maven project
# ─────────────────────────────────────────────

# ── Maven build output ─────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── IDE files ─────────────────────────────
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse / STS
.project
.classpath
.settings/
.springBeans
.sts4-cache/

# VS Code
.vscode/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ── OS files ──────────────────────────────
.DS_Store
Thumbs.db

# ── Environment / secrets ─────────────────
.env
*.env.local
*.env.*.local

# ── Docker ────────────────────────────────
# Don't ignore docker-compose.yml (it's tracked)
# But ignore override files that contain local secrets
docker-compose.override.yml

# ── Logs ──────────────────────────────────
*.log
logs/
spring.log
